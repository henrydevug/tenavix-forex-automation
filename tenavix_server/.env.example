# Copy to .env and fill in local values. Never commit .env.
# Used by PostgresPool.fromEnvironment() and integration tests.

TENAVIX_DB_HOST=localhost
TENAVIX_DB_PORT=5432
TENAVIX_DB_NAME=tenavix
TENAVIX_DB_USER=tenavix
TENAVIX_DB_PASSWORD=change_me_local_only

# JWT signing secret for local API runs (min 32 characters)
TENAVIX_JWT_SECRET=change_me_to_a_long_random_string_for_local_dev
